/dts-v1/;

#include "ipq5018.dtsi"
#include "ipq5018-qcn6122.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "CMCC RAX3000QY";
	compatible = "cmcc,rax3000qy", "qcom,ipq5018";

	aliases {
		serial0 = &blsp1_uart1;

		ethernet0 = &mac0;
		ethernet1 = &mac1;

		led-boot     = &led_status_green;
		led-failsafe = &led_status_red;
		led-running  = &led_status_green;
		led-upgrade  = &led_status_blue;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		bootargs-append = " root=/dev/ubiblock0_1 coherent_pool=2M";
	};
};

/* =======================
 * PINCTRL
 * ======================= */

&tlmm {
	uart_pins: uart-pins {
		pins = "gpio28", "gpio29";
		function = "blsp0_uart1";
		drive-strength = <8>;
		bias-disable;
	};

	qspi_nand_pins: qspi-nand-pins {
		clock {
			pins = "gpio9";
			function = "qspi_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cs {
			pins = "gpio8";
			function = "qspi_cs";
			drive-strength = <8>;
			bias-disable;
		};

		data0 { pins = "gpio7"; function = "qspi0"; drive-strength = <8>; bias-disable; };
		data1 { pins = "gpio6"; function = "qspi1"; drive-strength = <8>; bias-disable; };
		data2 { pins = "gpio5"; function = "qspi2"; drive-strength = <8>; bias-disable; };
		data3 { pins = "gpio4"; function = "qspi3"; drive-strength = <8>; bias-disable; };
	};

	mdio1_pins: mdio1-pins {
		mdc {
			pins = "gpio36";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};

		mdio {
			pins = "gpio37";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	led_pins: led-pins {
		pins = "gpio17", "gpio19", "gpio24";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
	};

	button_pins: button-pins {
		reset {
			pins = "gpio23";
			function = "gpio";
			bias-pull-up;
		};

		mesh {
			pins = "gpio38";
			function = "gpio";
			bias-pull-up;
		};
	};
};

/* =======================
 * UART
 * ======================= */

&blsp1_uart1 {
	pinctrl-0 = <&uart_pins>;
	pinctrl-names = "default";
	status = "okay";
};

/* =======================
 * NAND (⚠️ qpic_nand, not nand)
 * ======================= */

&qpic_bam {
	status = "okay";
};

&qpic_nand {
	pinctrl-0 = <&qspi_nand_pins>;
	pinctrl-names = "default";
	status = "okay";
};

/* =======================
 * LEDs / Buttons
 * ======================= */

&soc {
	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&led_pins>;
		pinctrl-names = "default";

		led_status_red: led-red {
			gpios = <&tlmm 24 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_STATUS;
			default-state = "on";
		};

		led_status_green: led-green {
			gpios = <&tlmm 19 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
		};

		led_status_blue: led-blue {
			gpios = <&tlmm 17 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_INTERNET;
		};
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		reset {
			label = "reset";
			gpios = <&tlmm 23 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
			debounce-interval = <60>;
		};

		mesh {
			label = "mesh";
			gpios = <&tlmm 38 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
			debounce-interval = <60>;
		};
	};
};

/* =======================
 * Ethernet / ESS
 * ======================= */

&mdio0 {
	status = "okay";

	resets = <&gcc GCC_GEPHY_MDC_SW_ARES>;
	reset-names = "phy";

	ge_phy: ethernet-phy@7 {
		reg = <7>;
	};
};

&mdio1 {
	status = "okay";
	pinctrl-0 = <&mdio1_pins>;
	pinctrl-names = "default";

	reset-gpios = <&tlmm 26 GPIO_ACTIVE_LOW>;

	ethernet-phy@0 { reg = <0>; };
	ethernet-phy@1 { reg = <1>; };
	ethernet-phy@2 { reg = <2>; };
	ethernet-phy@3 { reg = <3>; };
	ethernet-phy@4 { reg = <4>; };
};

&soc {
	mac0: dp1 {
		compatible = "qcom,nss-dp";
		device_type = "network";
		qcom,id = <1>;
		reg = <0x39c00000 0x10000>;
		interrupts = <GIC_SPI 101 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&gcc GCC_SNOC_GMAC0_AXI_CLK>;
		clock-names = "nss-snoc-gmac-axi-clk";
		qcom,mactype = <2>;
		phy-handle = <&ge_phy>;
		phy-mode = "internal";
	};

	mac1: dp2 {
		compatible = "qcom,nss-dp";
		device_type = "network";
		qcom,id = <2>;
		reg = <0x39d00000 0x10000>;
		interrupts = <GIC_SPI 109 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&gcc GCC_SNOC_GMAC1_AXI_CLK>;
		clock-names = "nss-snoc-gmac-axi-clk";
		qcom,mactype = <2>;
		phy-mode = "sgmii";
	};
};

/* =======================
 * Remoteproc / Wi-Fi
 * ======================= */

&q6v5_wcss {
	status = "okay";
};

/*
 * IPQ5018 内置 Wi-Fi：
 * ❌ 不要写 wifi0
 * ✔ ath11k 通过 remoteproc 自动创建
 */

/* QCN6122 (5G) */
&wifi1 {
	status = "okay";

	qcom,rproc = <&q6_wcss_pd2>;
	qcom,userpd-subsys-name = "q6v5_wcss_userpd2";

	qcom,ath11k-fw-memory-mode = <2>;
	qcom,bdf-addr = <0x4d100000>;
	qcom,m3-dump-addr = <0x4df00000>;
};
